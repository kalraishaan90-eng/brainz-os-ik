# =============================================================================
# Eduvia .gitignore — Production Secrets, Backups & Hardware Volumes
# =============================================================================

# Secrets & Environment Configurations
.env
.env.*
!.env.example

# Local On-Premises Persistent Storage Volumes
volumes/
volumes/db/data/
volumes/storage/

# Nightly Local Backups & Lockdown Snapshots
backups/
_backup*
*.backup*
*.bak*
*.orig
*.dump
*.sql.gz

# Node Dependencies
node_modules/
package-lock.json

# Test Reports and Debug Artifacts
test-results/
playwright-report/
.temp/
.freebuff/
*PRE-PROD-BACKUP.html
*PRE-QA-BACKUP.html
*-BACKUP.html
*-backup.html
scripts/audited-inventory.json
scripts/dynamic-elements.json
scripts/initial-inventory.json
scripts/static-elements.json
scripts/func-names.json
